<!--
  Custom Wazuh detection rules for the CERN lab.

  12 rules. The CV says "authored 12 custom detection rules covering SSH brute
  force, suspicious outbound DNS and unauthorised file modification, then tuned
  them against replayed attack traffic". These are those rules. If you change the
  count, change the CV.

  IDs 100000-109999 are the reserved local range. Levels: 0-3 informational,
  4-7 low, 8-11 medium, 12-15 high.

  Tuning notes are inline. Being able to say WHY a threshold is what it is, is
  the difference between "I copied rules" and "I wrote rules" in an interview.
-->

<group name="local,cern-lab,">

  <!-- 1. SSH brute force. 5716 is the Wazuh sshd failed-password SID.
       8 in 120s: low enough to fire on the replay script, high enough that a
       user fat-fingering a password twice does not page anyone. -->
  <rule id="100001" level="10" frequency="8" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force: 8+ failed authentications in 120s from $(srcip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

  <!-- 2. The one that actually matters: brute force followed by a success.
       Failed logins are noise; a success after them is an incident. -->
  <rule id="100002" level="14" frequency="1" timeframe="300">
    <if_matched_sid>100001</if_matched_sid>
    <if_sid>5715</if_sid>
    <same_source_ip />
    <description>SSH login SUCCEEDED from $(srcip) after a brute-force burst</description>
    <mitre><id>T1110.001</id><id>T1078</id></mitre>
  </rule>

  <!-- 3. Suspicious outbound DNS: very long query names. DGA and DNS-tunnelling
       both produce them. 52 chars was picked after the first run flagged
       legitimate CDN and cloud-provider names at 40. -->
  <rule id="100003" level="9">
    <decoded_as>json</decoded_as>
    <field name="_path">^dns$</field>
    <field name="query">^\S{52,}$</field>
    <description>Suspicious outbound DNS: abnormally long query $(query)</description>
    <mitre><id>T1071.004</id><id>T1568.002</id></mitre>
  </rule>

  <!-- 4. High query volume to a single domain. Tunnelling signature.
       Tuned from 50 to 120: Windows telemetry alone cleared 60/min. -->
  <rule id="100004" level="10" frequency="120" timeframe="60">
    <if_matched_sid>100003</if_matched_sid>
    <same_source_ip />
    <description>Possible DNS tunnelling: 120+ long queries in 60s from $(srcip)</description>
    <mitre><id>T1071.004</id></mitre>
  </rule>

  <!-- 5. DNS resolution of a MISP-listed domain. misp_ingest.py maintains the
       CDB list this matches against. -->
  <rule id="100005" level="12">
    <decoded_as>json</decoded_as>
    <field name="_path">^dns$</field>
    <list field="query" lookup="match_key">etc/lists/misp-domains</list>
    <description>DNS query for MISP-listed malicious domain: $(query)</description>
    <mitre><id>T1071.004</id></mitre>
  </rule>

  <!-- 6. Connection to a MISP-listed IP. -->
  <rule id="100006" level="12">
    <decoded_as>json</decoded_as>
    <field name="_path">^conn$</field>
    <list field="id.resp_h" lookup="address_match_key">etc/lists/misp-ips</list>
    <description>Connection to MISP-listed malicious IP $(id.resp_h)</description>
    <mitre><id>T1071</id></mitre>
  </rule>

  <!-- 7. Unauthorised file modification in a system path. 550 = FIM checksum
       changed, 554 = file added. Scoped to binary and config directories so
       ordinary /home churn does not drown the channel. -->
  <rule id="100007" level="12">
    <if_sid>550,554</if_sid>
    <field name="file">^/etc/|^/bin/|^/sbin/|^/usr/bin/|^/usr/sbin/|^/boot/</field>
    <description>Unauthorised modification of system file $(file)</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <!-- 8. FIM change to the auth stack specifically. Higher level: editing
       sshd_config or sudoers is how persistence gets installed. -->
  <rule id="100008" level="14">
    <if_sid>550,554</if_sid>
    <field name="file">^/etc/ssh/sshd_config|^/etc/sudoers|^/etc/pam\.d/|^/etc/passwd$|^/etc/shadow$</field>
    <description>Authentication configuration modified: $(file)</description>
    <mitre><id>T1098</id><id>T1556</id></mitre>
  </rule>

  <!-- 9. New account created. Cheap, high signal, almost never legitimate on a
       lab host that nobody administers but you. -->
  <rule id="100009" level="12">
    <if_sid>5902,5901</if_sid>
    <description>New user account or group created on $(agent.name)</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <!-- 10. auditd privileged command execution. Pairs with 02-linux-hardening,
       which installs the audit rules that generate these. -->
  <rule id="100010" level="8">
    <decoded_as>auditd</decoded_as>
    <field name="audit.key">privileged-exec</field>
    <description>Privileged command executed: $(audit.exe) by uid $(audit.auid)</description>
    <mitre><id>T1548.003</id></mitre>
  </rule>

  <!-- 11. Zeek notice passthrough, including the large-outbound-transfer notice
       raised in local.zeek. -->
  <rule id="100011" level="11">
    <decoded_as>json</decoded_as>
    <field name="_path">^notice$</field>
    <field name="note">Notice::Tally|SSH::Password_Guessing|Intel::Notice</field>
    <description>Zeek notice: $(msg)</description>
    <mitre><id>T1048</id></mitre>
  </rule>

  <!-- 12. Rare user agent on outbound HTTP. Catches scripted clients and a lot
       of commodity malware that never bothers to spoof one properly. -->
  <rule id="100012" level="7">
    <decoded_as>json</decoded_as>
    <field name="_path">^http$</field>
    <field name="user_agent">^(curl|wget|python-requests|Go-http-client|libwww-perl)</field>
    <description>Scripted HTTP client on the wire: $(user_agent) to $(host)</description>
    <mitre><id>T1071.001</id></mitre>
  </rule>

</group>
